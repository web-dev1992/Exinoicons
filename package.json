{
  "name": "exinoicons",
  "version": "0.0.0",
  "private": true,
  "description": "Official exinoicons libraries for React, Vue, Svelte, Angular, React Native, Flutter, and more.",
  "homepage": "https://exinoicons.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/exinoicons/exinoicons.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean",
    "docs:dev": "pnpm --filter @exinoicons/docs dev",
    "docs:build": "pnpm --filter @exinoicons/docs build",
    "docs:preview": "pnpm --filter @exinoicons/docs preview"
  },
  "devDependencies": {
    "rimraf": "^6.1.3"
  }
}
