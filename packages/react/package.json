{
  "name": "@exinoicons/react",
  "version": "2.0.0",
  "description": "Tree-shakeable React icon components for Exinoicons",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/esm",
    "dist/cjs",
    "dist/types",
    "CHANGELOG.md",
    "LICENSE.md",
    "PRO-LICENSE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exinoicons/exinoicons.git",
    "directory": "packages/react"
  },
  "dependencies": {
    "@exinoicons/core-free-icons": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=16.0.0"
  },
  "scripts": {
    "generate": "node ./scripts/generate-icon-components.mjs",
    "clean": "rimraf dist",
    "build:bundles": "rollup -c ./rollup.config.mjs",
    "pack:check": "npm pack --dry-run",
    "publish:beta": "pnpm build && npm publish --tag beta --no-git-checks",
    "publish:prod": "pnpm build && npm publish --no-git-checks",
    "build:types": "rollup -c ./rollup.types.config.mjs",
    "build": "pnpm clean && pnpm generate && pnpm build:types && pnpm build:bundles"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/react": "^19.3.0",
    "rollup": "^4.66.0",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^5.7.3"
  }
}
