{
  "name": "@exinoicons/angular",
  "version": "1.0.12",
  "description": "Exinoicons Angular Component Library https://exinoicons.com",
  "homepage": "https://exinoicons.com",
  "license": "MIT",
  "type": "module",
  "main": "./dist/bundles/exinoicons-angular.umd.js",
  "module": "./dist/fesm2022/exinoicons-angular.mjs",
  "typings": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE.md",
    "PRO-LICENSE.md",
    "README.md"
  ],
