{
  "name": "@exinoicons/solid-js",
  "version": "1.0.0",
  "description": "Exinoicons SolidJS Component Library https://exinoicons.com",
  "homepage": "https://exinoicons.com",
  "license": "MIT",
  "amdName": "exinoicons-solid-js",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "solid": "./dist/source/index.jsx",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE.md",
    "PRO-LICENSE.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/exinoicons/exinoicons.git",
    "directory": "packages/solid-js"
  },
  "bugs": {
    "url": "https://github.com/exinoicons/exinoicons/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "solid": "./dist/source/index.jsx",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "browser": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "node": "./dist/cjs/index.js"
    }
  },
  "author": "Exinoicons",
  "scripts": {
    "build": "pnpm clean && pnpm typecheck && pnpm build:bundles",
    "build:bundles": "rollup -c ./rollup.config.mjs",
    "typecheck": "tsc",
    "clean": "rm -rf dist",
    "publish:beta": "pnpm build && npm publish --tag beta --no-git-checks",
    "publish:prod": "pnpm build && npm publish --no-git-checks"
  },
  "devDependencies": {
    "rollup": "^3.0.0",
    "rollup-preset-solid": "^3.0.0",
    "solid-js": "^1.8.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "keywords": [
    "exinoicons",
    "solid",
    "solidjs",
    "icons",
    "solid-icons",
    "svg-icons",
    "svg",
    "vector-icons",
    "icon-library",
    "typescript"
  ]
}
